# Copie para .env.local e preencha com os valores do seu projeto Supabase.
# Use SOMENTE a chave publicável (anon / publishable) aqui.
# A chave secreta (service_role / sb_secret_...) NUNCA entra no app:
# fica só no dashboard do Supabase, em Edge Function secrets ou no gerenciador de senhas.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_COLE_AQUI
